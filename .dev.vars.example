# Copy to .dev.vars (gitignored). Read by wrangler dev. No API key here: the Worker never sees it.
# Passcode for the dashboard's "Reset demo data" button.
ADMIN_PASSCODE=change-me
# Optional: require this passcode before anyone can use the chat API.
# APP_PASSCODE=
# Hosted mode uses Cloudflare secrets instead of this file:
#   npx wrangler secret put APP_PASSCODE --env hosted
#   npx wrangler secret put ADMIN_PASSCODE --env hosted
