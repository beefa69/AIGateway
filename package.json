{
  "name": "switchyard-router-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "router:up": "docker compose up -d --build --wait",
    "router:down": "docker compose down",
    "router:logs": "docker compose logs -f switchyard",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "dev": "npm run router:up && npm run db:migrate && wrangler dev",
    "typecheck": "tsc --noEmit",
    "demo:run": "node scripts/run-demo.mjs"
  },
  "dependencies": {
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261119.1",
    "typescript": "5.9.3",
    "wrangler": "4.165.0"
  }
}
