{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchyard-router-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    // Local-only demo: wrangler dev keeps this database on disk under .wrangler/.
    // The id is a placeholder; it only matters if you ever deploy.
    { "binding": "DB", "database_name": "switchyard-demo", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "vars": {
    "SWITCHYARD_URL": "http://127.0.0.1:4000",
    "RATE_LIMIT_PER_MIN": "30"
  },
  // Loopback only. The audience sees it through your Zoom screen share.
  "dev": { "ip": "127.0.0.1", "port": 8787 }
}
